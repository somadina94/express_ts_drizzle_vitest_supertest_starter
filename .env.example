NODE_ENV=development

# Host machine (npm run dev): Postgres on localhost.
DATABASE_URL="postgresql://postgres:secret@localhost:5432/postgres"

# Optional: direct URL for drizzle-kit when DATABASE_URL uses a pooler.
# DIRECT_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Docker Compose dev — override if credentials differ:
# DOCKER_DATABASE_URL=postgresql://postgres:secret@postgres:5432/postgres

PORT=3000
JWT_SECRET=change-me-in-production-use-at-least-32-chars-in-prod
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://app.example.com

# TRUST_PROXY=false
# RATE_LIMIT_WINDOW_MS=3600000
# RATE_LIMIT_MAX=1000

LOG_LEVEL=info
LOG_PRETTY=true

COMPANY_NAME=Express TS Drizzle Base

# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_SECURE=
# EMAIL_REQUIRE_TLS=
# EMAIL_TLS_REJECT_UNAUTHORIZED=
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=
# EMAIL_FROM=
