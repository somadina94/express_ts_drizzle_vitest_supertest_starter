{
  "name": "express-ts-drizzle-base",
  "version": "1.0.0",
  "description": "Express TS Drizzle Server Base",
  "main": "server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build --watch",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "build": "tsc && mkdir -p dist/views && cp -r src/views dist/",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "jahbyte",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.6",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.20.0",
    "@types/pug": "^2.0.10",
    "@types/validator": "^13.15.10",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "pug": "^3.0.4",
    "slugify": "^1.6.6",
    "validator": "^13.15.35"
  }
}
